# ============================================
# Dynamic Production Scheduler (DPS)
# Environment Variables — PRODUCTION TEMPLATE
# ============================================
# 1. cp .env.example .env
# 2. Tüm CHANGE_ME değerlerini güçlü rastgele şifrelerle değiştirin
#    Örnek: openssl rand -hex 32
# 3. DOMAIN_NAME'i sunucunuzun IP/domain adresiyle güncelleyin
# ============================================

# --- Sunucu ---
DOMAIN_NAME=localhost   # Örn: planlama.example.com
SSL_EMAIL=admin@example.com  # Let's Encrypt bildirimler için

# --- PostgreSQL ---
POSTGRES_USER=dps_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=dps_database

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password_min12chars
MINIO_BUCKET_NAME=dps-uploads

# --- JWT (openssl rand -hex 32 ile üretin) ---
JWT_SECRET_KEY=CHANGE_ME_64_char_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# --- Authentik / OIDC ---
# Authentik uygulamasında Redirect URI:
# http(s)://DOMAIN_NAME/api/auth/authentik/callback
AUTHENTIK_SECRET_KEY=CHANGE_ME_authentik_secret_key
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=CHANGE_ME_authentik_postgres_password
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/dps/
AUTHENTIK_INTERNAL_URL=http://authentik_server:9000/application/o/dps/
AUTHENTIK_CLIENT_ID=CHANGE_ME_authentik_client_id
AUTHENTIK_CLIENT_SECRET=CHANGE_ME_authentik_client_secret
AUTHENTIK_REDIRECT_URI=https://DOMAIN_NAME/api/auth/authentik/callback
AUTHENTIK_FRONTEND_CALLBACK_URL=https://DOMAIN_NAME/auth/authentik/callback
AUTHENTIK_SCOPE=openid profile email
AUTHENTIK_AUTO_APPROVE=true
AUTHENTIK_DEFAULT_ROLE=VIEWER
AUTHENTIK_GROUPS_CLAIM=groups
AUTHENTIK_ADMIN_GROUP=dps-admins
AUTHENTIK_PLANNER_GROUP=dps-planners

# --- Nginx ---
NGINX_PORT=80

# --- MAIL ---
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
# Virgulle ayirarak birden fazla alici yazabilirsiniz. Bos birakilirsa SMTP_EMAIL kullanilir.
ORDER_COMPLETION_EMAIL_TO=
PURCHASING_EMAIL_TO=
